# Copy to .env and fill in. Never commit .env. Names only here - no real values.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Chassis
APP_PORT=3100                      # docker-compose host port (bound to 127.0.0.1)

# --- Database ---
DATABASE_URL=postgres://chassis:change-me@localhost:5432/chassis
POSTGRES_PASSWORD=change-me        # docker-compose postgres

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=                # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000

# --- Email (magic link, invitations). Empty SMTP_URL = links are logged to the console (dev only) ---
SMTP_URL=                          # smtp://user:pass@host:587
MAIL_FROM=Chassis <no-reply@example.com>

# --- Billing: pick one provider ---
BILLING_PROVIDER=paddle            # paddle | lemonsqueezy | polar
# Paddle
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox                 # sandbox | production
# Lemon Squeezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Provider price ids (Paddle price id / Lemon Squeezy variant id), referenced by config/plans.ts
PRICE_PRO_MONTH=
PRICE_PRO_YEAR=
PRICE_TEAM_MONTH=
PRICE_TEAM_YEAR=

# --- AI gateway (OpenAI-compatible, e.g. our LiteLLM) ---
AI_GATEWAY_URL=                    # https://gateway.example.com/v1
AI_GATEWAY_KEY=
AI_MODEL_GROUP=                    # gateway model-group name, defined in the gateway config

# --- Analytics (Umami) ---
NEXT_PUBLIC_UMAMI_URL=             # https://umami.example.com
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
