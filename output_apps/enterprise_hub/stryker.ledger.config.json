{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "comment": "T173 nightly mutation report scoped to the ledger module (report-only, no gate yet).",
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "package.json",
    "enableFindRelatedTests": true
  },
  "mutate": [
    "modules/accounting/money.ts",
    "modules/accounting/services/accounting.service.ts"
  ],
  "reporters": [
    "html",
    "json",
    "clear-text",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/ledger/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/ledger/mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "concurrency": 2,
  "timeoutMS": 15000
}
