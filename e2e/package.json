{
  "name": "@roxira/e2e-smoke",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only Playwright smoke tests against the live production site.",
  "scripts": {
    "test": "playwright test",
    "test:app": "playwright test -c playwright.app.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
