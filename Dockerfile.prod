FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --no-cache-dir psycopg fastapi uvicorn pydantic python-docx pymupdf redis httpx langgraph sentence-transformers sqlalchemy python-multipart "pydantic[email]" faster-whisper
# موتور پردازش اسناد (Docs/PDF/تصویر → Markdown): چیدمان، جدول و OCR چندزبانه
RUN pip install --no-cache-dir docling
# موتور گراف دانش حقوقی (LightRAG): موجودیت/رابطه + بازیابی برداری ترکیبی
RUN pip install --no-cache-dir lightrag-hku
# TTS مسیر آبشاری صدای زنده (smartjudge_live_voice.py): edge-tts هرگز اینجا
# نصب نشده بود (W20 diagnosis) -- یعنی هر پاسخ صوتی از ابتدا و بی‌صدا شکست
# می‌خورد. google-genai برای مسیر اختیاری VOICE_REALTIME_PROVIDER=gemini
# (پیش‌فرض خاموش، docs/W20_realtime_voice.md) است.
RUN pip install --no-cache-dir edge-tts google-genai

COPY output_apps /app/output_apps
COPY src /app/src
COPY run_unified_server.py /app/run_unified_server.py

EXPOSE 8000

CMD ["python3", "run_unified_server.py"]
