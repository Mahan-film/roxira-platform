OPENROUTER_API_KEY=your_openrouter_api_key_here
POSTGRES_DB=enterprise_db
POSTGRES_USER=enterprise_admin
POSTGRES_PASSWORD=your_secure_password
KAVENEGAR_API_KEY=your_kavenegar_key
# استخر چندکلیدی AssemblyAI برای گفتاربه‌متن (با جداکننده کاما؛ چرخش خودکار روی 401/402/429)
ASSEMBLYAI_API_KEYS=your_assemblyai_key_1,your_assemblyai_key_2
# مدل گفتاربه‌متن (universal-2 تنها مدل AssemblyAI با پشتیبانی رسمی از زبان فارسی)
ASSEMBLYAI_STT_MODEL=universal-2
