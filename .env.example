OPENROUTER_API_KEY=your_openrouter_api_key_here
POSTGRES_DB=enterprise_db
POSTGRES_USER=enterprise_admin
POSTGRES_PASSWORD=your_secure_password
KAVENEGAR_API_KEY=your_kavenegar_key
# استخر ۵ کلیدی AssemblyAI برای گفتاربه‌متن (با جداکننده کاما؛ غیرفعال‌سازی خودکار کلید روی 401/402/429)
ASSEMBLYAI_API_KEYS=your_assemblyai_key_1,your_assemblyai_key_2,your_assemblyai_key_3,your_assemblyai_key_4,your_assemblyai_key_5
# مدل گفتاربه‌متن با بالاترین دقت فارسی (speech_model=best؛ گزینه سبک‌وزن: nano)
ASSEMBLYAI_STT_MODEL=best
# DSN رسمی دیتابیس هوش مصنوعی SmartJudge
SMARTJUDGE_DATABASE_URL=postgresql://enterprise_admin:your_secure_password@postgres_prod:5432/enterprise_db
# موتور فوق‌سریع بررسی سینتکس/LSP در خط تولید کارخانه خودگردان
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_CODE_MODEL=qwen-3.8-27b
# موتور تولید قرارداد OpenAPI و اسکیمای DTO
SAMBANOVA_API_KEY=your_sambanova_api_key_here
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_CONTRACT_MODEL=DeepSeek-V3.2
# ریشه اجرای ایزوله تسک‌های کدنویسی (git worktrees)
FACTORY_WORKTREES_ROOT=/opt/roxira_platform/.factory_worktrees
FACTORY_LATENCY_BUDGET_MS=200
# ==========================
# ROXIRA WEB INTELLIGENCE — NEURAL SEARCH, CRAWL & RERANK
# ==========================
# Jina Reader + Reranker (خط لوله RAG)
JINA_API_KEY=your_jina_api_key_here
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
# Exa.ai — جستجوی معنایی نورونی
EXA_API_KEY=your_exa_api_key_here
EXA_BASE_URL=https://api.exa.ai
# Firecrawl — خزش و استخراج Markdown
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# Tavily — استخر چندکلیدی (با جداکننده کاما)
TAVILY_API_KEYS=your_tavily_key_1,your_tavily_key_2
TAVILY_BASE_URL=https://api.tavily.com
# Brave Search
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1
# Groq — کلید سرویس STT
GROQ_API_KEY=your_groq_api_key_here

# Required secrets (no default; the code fails at startup without them)
JWT_SECRET=
JWT_SECRET_KEY=
SMS_IR_API_KEY=
KIRA_API_KEY=
# Twenty CRM (docker-compose.modern-stack.yml)
TWENTY_APP_SECRET=
TWENTY_ENCRYPTION_KEY=
