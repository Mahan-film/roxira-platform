OPENROUTER_API_KEY=your_openrouter_api_key_here
# Business suite AI assistant: off unless true
ASSISTANT_ENABLED=false
# Business suite AI assistant: questions per tenant per hour (default 20)
ASSISTANT_RATE_LIMIT_PER_HOUR=20
POSTGRES_DB=enterprise_db
POSTGRES_USER=enterprise_admin
POSTGRES_PASSWORD=your_secure_password
KAVENEGAR_API_KEY=your_kavenegar_key
# استخر ۵ کلیدی AssemblyAI برای گفتاربه‌متن (با جداکننده کاما؛ غیرفعال‌سازی خودکار کلید روی 401/402/429)
ASSEMBLYAI_API_KEYS=your_assemblyai_key_1,your_assemblyai_key_2,your_assemblyai_key_3,your_assemblyai_key_4,your_assemblyai_key_5
# مدل گفتاربه‌متن با بالاترین دقت فارسی (speech_model=best؛ گزینه سبک‌وزن: nano)
ASSEMBLYAI_STT_MODEL=best
# DSN رسمی دیتابیس هوش مصنوعی SmartJudge
SMARTJUDGE_DATABASE_URL=postgresql://enterprise_admin:your_secure_password@postgres_prod:5432/enterprise_db
# موتور تولید قرارداد OpenAPI و اسکیمای DTO
SAMBANOVA_API_KEY=your_sambanova_api_key_here
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_CONTRACT_MODEL=DeepSeek-V3.2
# ریشه اجرای ایزوله تسک‌های کدنویسی (git worktrees)
FACTORY_WORKTREES_ROOT=/opt/roxira_platform/.factory_worktrees
FACTORY_LATENCY_BUDGET_MS=200
# ==========================
# ROXIRA WEB INTELLIGENCE — NEURAL SEARCH, CRAWL & RERANK
# ==========================
# Jina Reader + Reranker (خط لوله RAG)
JINA_API_KEY=your_jina_api_key_here
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
# Exa.ai — جستجوی معنایی نورونی
EXA_API_KEY=your_exa_api_key_here
EXA_BASE_URL=https://api.exa.ai
# Firecrawl — خزش و استخراج Markdown
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# Tavily — استخر چندکلیدی (با جداکننده کاما)
TAVILY_API_KEYS=your_tavily_key_1,your_tavily_key_2
TAVILY_BASE_URL=https://api.tavily.com
# Brave Search
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1
# Groq — کلید سرویس STT
GROQ_API_KEY=your_groq_api_key_here
# Multi-key voice + embeddings (all optional, inert when empty; key_rotation.py).
# Every provider also reads <NAME>_2 .. <NAME>_4. A key that answers 429/5xx/401 cools down.
# STT chain (voice_stt.py; default order openrouter,assemblyai = production before multi-key).
# Opt in to the wide chain: VOICE_STT_ORDER=assemblyai,groq,mistral,openrouter,gemini  and hedging: VOICE_STT_HEDGE=1
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_API_KEYS=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY_2=
VOICE_STT_ORDER=
VOICE_STT_HEDGE=
VOICE_STT_HEDGE_S=4
# TTS: edge-tts inline by default; Azure (voice_tts.py) is used only when these are set, edge-tts on any error: Azure AI Speech, same fa-IR neural voices
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Query embeddings with EMBED_BACKEND=cf: BAAI/bge-m3 ONLY (other models = other vector space)
CF_ACCOUNT_ID=
CF_AI_TOKEN=
CF_ACCOUNT_ID_2=
CF_AI_TOKEN_2=
MODAL_EMBED_URL=
MODAL_EMBED_TOKEN=
DEEPINFRA_API_KEY=
CHUTES_EMBED_URL=
CHUTES_API_KEY=
EMBED_REMOTE_BUDGET_S=6
# خاموش به‌صورت پیش‌فرض؛ با 1 مسیر چت SmartJudge از روتر مرکزی عبور می‌کند
LLM_ROUTER_ENABLED=0
# لیست مدل‌های هر سطح (آرایهٔ fallback اوپن‌روتر، به ترتیب اولویت). داده حساس هرگز به :free نمی‌رود
LLM_TIER_FREE=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
LLM_TIER_CHEAP=deepseek/deepseek-v4.1-flash,qwen/qwen3.8-flash,google/gemini-3.1-flash-lite
LLM_TIER_STRONG=google/gemini-3.8-flash,deepseek/deepseek-v4-pro-0813,z-ai/glm-5.3
# نگاشت پلن اشتراک SmartJudge به سطح روتر
SMARTJUDGE_ROUTER_TIER_VIP=strong
SMARTJUDGE_ROUTER_TIER_FREE=cheap
# کش Redis فقط برای temperature=0 (ثانیه؛ 0 = خاموش). از REDIS_URL یا REDIS_HOST/REDIS_PORT
LLM_CACHE_TTL_SECONDS=86400
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60
# درخواست‌های حساس فقط به providerهایی که داده را ذخیره/آموزش نمی‌دهند (provider.data_collection=deny)
LLM_SENSITIVE_DENY_DATA_COLLECTION=1
# لاگ هزینه: فایل JSONL و/یا جدول llm_usage در Postgres (جدول خودکار ساخته می‌شود)
LLM_USAGE_LOG_PATH=/opt/roxira_platform/data/llm_usage.jsonl
LLM_USAGE_DSN=
=======
KIRA_API_KEY=
JWT_SECRET=
# NestJS password-reset email (all optional; defaults shown). Access tokens last 15 min by default.
# JWT_EXPIRES_IN=15m
# SMTP_HOST=roxira_mail
# SMTP_PORT=25
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Roxira <info@roxira.net>
# PORTAL_URL_IR=https://roxira.ir
# PORTAL_URL_NET=https://roxira.net
# ===================
=======

# Required secrets (no default; the code fails at startup without them)
JWT_SECRET_KEY=
# Twenty CRM (docker-compose.modern-stack.yml)
TWENTY_APP_SECRET=
TWENTY_ENCRYPTION_KEY=
# LLM ROUTER (docs/STRATEGY.md §3b) — output_apps/generated_modules/smartjudge/llm_router.py
# ===================
# W17 — Zibal payments (real gateway). See docs/W17_payment_fix.md.
ZIBAL_MERCHANT=
PAYMENTS_LIVE=0
PAYMENTS_CRYPTO_ENABLED=0
# Moadian (سامانه مودیان) live integration — output_apps/enterprise_hub/modules/tax_compliance
# Off by default. Default base URL is the sandbox; production is
# https://tp.tax.gov.ir/requestsmanager/api/v2 (set explicitly).
MOADIAN_ENABLED=false
MOADIAN_BASE_URL=https://sandboxrc.tax.gov.ir/requestsmanager/api/v2
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts each tenant's private key at rest.
MOADIAN_KEY_ENCRYPTION_KEY=
MOADIAN_POLL_DELAY_MS=60000
MOADIAN_MAX_POLLS=30
