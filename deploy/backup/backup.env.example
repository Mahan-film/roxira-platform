# /etc/roxira/backup.env  (chmod 600, root only). Copy from this template; NEVER commit real values.
# The restic password lives in its own root-only file, not here: /etc/roxira/restic.pass (chmod 600)
RESTIC_PASSWORD_FILE=/etc/roxira/restic.pass

# No Storage Box / no S3? Set this to 1: the hourly run keeps local dump sets only and reports OK; the owner's
# Mac pulls sets/latest daily (scripts/ops/backup/mac_pull.sh). Ignored as soon as any repository below is set.
BACKUP_ALLOW_LOCAL_ONLY=0

# (a) Primary offsite: Hetzner Storage Box over sftp (ssh port 23). Leave BACKUP_SB_USER empty to disable.
BACKUP_SB_USER=
BACKUP_SB_HOST=
BACKUP_SB_PORT=23
BACKUP_SB_KEY=/root/.ssh/storagebox_backup
BACKUP_SB_PATH=roxira-restic

# (b) Optional second offsite: S3-compatible (Cloudflare R2 / Backblaze B2). Leave BACKUP_S3_ENDPOINT empty to disable.
# R2 endpoint form: https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=roxira
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Email (Gmail App Password, needs 2-Step Verification). Leave BACKUP_SMTP_PASS empty to disable mail.
BACKUP_SMTP_HOST=smtp.gmail.com
BACKUP_SMTP_PORT=587
BACKUP_SMTP_USER=
BACKUP_SMTP_PASS=
BACKUP_NOTIFY_TO=
# age PUBLIC key (age1...) for the weekly config bundle; the private key stays on the owner's Mac.
BACKUP_AGE_RECIPIENT=

# Tunables (defaults shown)
# BACKUP_LOCAL_DIR=/opt/roxira_backups/dr
# BACKUP_KEEP_LOCAL_SETS=3
# Optional restic repo on the server itself (local disk; also the 'local' repo name in status):
# BACKUP_LOCAL_REPO=/opt/roxira_backups/dr/restic
# BACKUP_DISK_WARN_PCT=85
# BACKUP_DISK_ABORT_PCT=95
# BACKUP_QDRANT_PRUNE_OLD=0
# QDRANT_API_KEY=

# Offsite-by-email (docs/ops/BACKUP_EMAIL.md). Needs BACKUP_AGE_RECIPIENT + SMTP settings above.
# BACKUP_EMAIL_OFFSITE=off            # off | daily | weekly (weekly = BACKUP_BUNDLE_DOW, default Sunday)
# BACKUP_EMAIL_EXTRA_PATHS=           # space-separated extra paths, e.g. the staged legal-corpus JSONL dir
# BACKUP_EMAIL_PART_MB=17             # raw MB per mail (Gmail limit 25 MB after base64)
# BACKUP_EMAIL_MAX_MAILS=10           # per run
# BACKUP_EMAIL_MAX_DAY_MB=150         # per UTC day
