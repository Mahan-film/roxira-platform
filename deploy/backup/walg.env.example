# /etc/roxira/walg.env  (root:root, chmod 600). NAMES ONLY here; put the real values on the server, never in git.
# Used three ways: docker compose env_file for postgres_prod, sourced by the host scripts in scripts/ops/walg/,
# and passed to the throwaway restore container on the Mac (restore_to_time.sh --env-file).

# --- R2 (S3-compatible). Same bucket as the pgcfg backups, new prefix "walg". Prefer a SEPARATE R2 API token.
WALG_S3_PREFIX=s3://<bucket>/walg
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_REGION=auto
AWS_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Encryption: WAL-G native libsodium (secretbox, symmetric). 32 random bytes as 64 hex chars:
#       openssl rand -hex 32
#     Keep a copy OFF the server (password manager): without it the backups cannot be read.
WALG_LIBSODIUM_KEY=
WALG_LIBSODIUM_KEY_TRANSFORM=hex

# --- Behaviour
WALG_COMPRESSION_METHOD=lz4
WALG_DELTA_MAX_STEPS=0

# --- Connection from inside the container (local socket, same user as POSTGRES_USER in docker-compose.prod.yml)
PGHOST=/var/run/postgresql
PGUSER=enterprise_admin
PGDATABASE=enterprise_db

# --- Spool guard (walg-archive.sh)
WALG_SPOOL_MAX_MB=3072
WALG_PUSH_TIMEOUT_S=45
WALG_SPOOL_ON_OVERFLOW=drop
