<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Law watch: polls ekhtebar.ir (reachable only from Iranian IPs; run with the VPN OFF) every 6 h.
     launchd also runs it at load and after wake, and the cursor in ~/.roxira/law_watch/state.json
     makes every run catch up on whatever was missed. SMTP settings are read at runtime from ~/Secrets/roxira/roxira.env (no secrets here). Placeholders __REPO__ / __HOME__ / __PYTHON__ are
     filled in by scripts/legal/install_law_watch_mac.sh. Not loaded automatically. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>ir.roxira.lawwatch</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__REPO__/scripts/legal/law_watch.py</string>
    <string>run</string>
    <string>--email</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin</string>
  </dict>
  <key>StartInterval</key><integer>21600</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>__HOME__/.roxira/law_watch/out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.roxira/law_watch/err.log</string>
</dict>
</plist>
