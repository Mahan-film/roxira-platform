[Unit]
Description=Roxira backup restore drill (fresh payload -> scratch Postgres, pass/fail)
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/roxira_platform
ExecStart=/opt/roxira_platform/scripts/ops/backup/server_backup.sh drill
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=1h
