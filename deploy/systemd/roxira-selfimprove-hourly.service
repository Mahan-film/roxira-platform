[Unit]
Description=Roxira Smart Judge self-improvement: hourly retrieval eval and latency/error metrics (read-only, proposals only)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/roxira/monitor.env
EnvironmentFile=-/etc/roxira/selfimprove.env
WorkingDirectory=/opt/roxira_platform
ExecStart=/usr/bin/python3 /opt/roxira_platform/scripts/ops/selfimprove/hourly.py
# Exit 1 just means "a check is failing"; the alert is the e-mail, not the unit state.
SuccessExitStatus=0 1
StateDirectory=roxira-selfimprove
User=root
Nice=15
TimeoutStartSec=900
