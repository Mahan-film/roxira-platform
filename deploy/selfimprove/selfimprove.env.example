# Copy to /etc/roxira/selfimprove.env (mode 600). Names only; set real values on the server.
# Optional: the loop also reads BACKUP_SMTP_* from /etc/roxira/monitor.env and OPENROUTER_API_KEY.
SELFIMPROVE_DAILY_USD=0.30
SELFIMPROVE_GOLDEN_MAX=20
SELFIMPROVE_EST_USD_PER_CHAT=0.004
SELFIMPROVE_BASE_URL=http://127.0.0.1:8000
SELFIMPROVE_STATE_DIR=/var/lib/roxira-selfimprove
SELFIMPROVE_APP_CONTAINER=roxira_app_prod
OPENROUTER_API_KEY=
SELFIMPROVE_GH_ISSUES=0
SELFIMPROVE_GH_REPO=
GH_ISSUES_TOKEN=
