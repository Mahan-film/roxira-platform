# /etc/roxira/monitor.env  (chmod 600, root). Names only here; set real values on the server.
BACKUP_SMTP_USER=
BACKUP_SMTP_PASS=
BACKUP_NOTIFY_TO=
# Optional tuning (defaults shown)
MONITOR_DOMAINS=ghazihoushmand.ir,roxira.ir,roxira.net
MONITOR_CHAT_INTERVAL_MIN=15
MONITOR_CHAT_TIMEOUT_S=45
MONITOR_CERT_WARN_DAYS=21
MONITOR_DISK_WARN_PCT=85
MONITOR_CHECK_DISK=1
MONITOR_5XX_MAX=3
MONITOR_CLIENT_ERR_MAX=10
MONITOR_P95_MAX_S=40
MONITOR_LOG_MINUTES=10
# Set to 1 to mute e-mail (checks still run and state is kept)
MONITOR_SILENCE=0
