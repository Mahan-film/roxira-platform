# Copy to .env (chmod 600). Never commit .env.

# --- LiveKit (local, direct, never proxied) ---
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_WS_URL=ws://127.0.0.1:7880
# Set strong credentials from livekit.yaml (required; startup fails if empty)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ROOM_PREFIX=call-
SIP_IDENTITY_PREFIX=sip_

# --- Proxy: ONLY for blocked foreign APIs (Groq/OpenAI/Microsoft TTS) ---
PROXY_URL=http://127.0.0.1:10808

# Key pool file (loaded after .env; .env wins)
SECRETS_ENV_FILE=/home/mahan/Secrets/roxira/roxira.env

# --- Speech to text: groq | openai | smartjudge ---
STT_PROVIDER=groq
# keys come from SECRETS_ENV_FILE; an empty KEY= line here would hide the pool value
# GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
# OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

# --- Text to speech: edge (local sidecar, free) | openai | smartjudge ---
TTS_PROVIDER=edge
EDGE_TTS_URL=http://127.0.0.1:5055
TTS_VOICE=fa-IR-FaridNeural
TTS_RATE=+8%
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# --- Smart Judge brain (domestic, direct) ---
SMARTJUDGE_BASE=https://ghazihoushmand.ir/api/v1/apps/judge
# Service gateway key for the phone line (loaded from SECRETS_ENV_FILE; required unless SMARTJUDGE_TOKEN is set)
# SMARTJUDGE_PHONE_GATEWAY_KEY=
# Optional user bearer token fallback
SMARTJUDGE_TOKEN=
SMARTJUDGE_TIMEOUT_MS=45000

# --- Turn taking ---
VAD_START_MS=160
VAD_END_SILENCE_MS=750
VAD_MIN_UTTERANCE_MS=350
VAD_MAX_UTTERANCE_MS=20000
VAD_ENERGY_RATIO=3.0
VAD_MIN_RMS=350
BARGE_IN_MS=300

# --- Calls ---
MAX_CONCURRENT_CALLS=3
MAX_CALL_SECONDS=900
IDLE_HANGUP_SECONDS=60
