        "components": {
          "schemas": {
            "Account": {
              "type": "object",
              "description": "Chart-of-accounts node (double-entry ledger account).",
              "required": [
                "code",
                "title",
                "type"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "format": "int64"
                },
                "code": {
                  "type": "string",
                  "maxLength": 20
                },
                "title": {
                  "type": "string",
                  "maxLength": 200
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "ASSET",
                    "LIABILITY",
                    "EQUITY",
                    "INCOME",
                    "EXPENSE"
                  ]
                },
                "balance": {
                  "type": "number",
                  "format": "double"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "JournalEntry": {
              "type": "object",
              "description": "A double-entry voucher header.",
              "required": [
                "entry_number",
                "date",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "format": "int64"
                },
                "entry_number": {
                  "type": "string",
                  "maxLength": 40
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "description": {
                  "type": "string",
                  "maxLength": 400
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "DRAFT",
                    "POSTED"
                  ]
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "JournalItem": {
              "type": "object",
              "description": "One debit or credit line of a journal entry.",
              "required": [
                "entry_id",
                "account_id"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "format": "int64"
                },
                "entry_id": {
                  "type": "integer",
                  "format": "int64"
                },
                "account_id": {
                  "type": "integer",
                  "format": "int64"
                },
                "debit": {
                  "type": "number",
                  "format": "double"
                },
                "credit": {
                  "type": "number",
                  "format": "double"
                }
              }
            },
            "Invoice": {
              "type": "object",
              "description": "Sales / purchase invoice.",
              "required": [
                "number",
                "total_amount"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "format": "int64"
                },
                "number": {
                  "type": "string",
                  "maxLength": 40
                },
                "party_name": {
                  "type": "string",
                  "maxLength": 200
                },
                "total_amount": {
                  "type": "number",
                  "format": "double"
                },
                "tax_amount": {
                  "type": "number",
                  "format": "double"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "DRAFT",
                    "ISSUED",
                    "PAID",
                    "CANCELLED"
                  ]
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
