{
  "permissions": {
    "deny": [
      "Read(./repomix-output.xml)",
      "Read(./database_snapshots/**)",
      "Read(./**/*.sql)",
      "Read(./**/*.tar.gz)",
      "Read(./**/*.snapshot)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post_edit_lint.sh"
          }
        ]
      }
    ]
  }
}
