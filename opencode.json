{
  "$schema": "https://opencode.ai/config.json",
  "//": "W12 model registry. Model ids come from config/models.yaml's `executor` role (docs/STRATEGY.md §3, W12 row) — see output_apps/generated_modules/smartjudge/model_registry.py for the loader. Wired into .github/workflows/agent-task.yml via agent_runner.py's run_opencode(), which calls `opencode run --agent build --model <executor id>`. `ask` permissions are never used here: OpenCode runs non-interactively in CI (no terminal to answer a prompt), so an `ask` entry would hang until AGENT_TASK_TIMEOUT_SECS kills the run. Every permission below is explicit allow or deny.",
  "//providers": "Keys come ONLY from the environment via {env:NAME} (see docs/ops/OPENCODE_KEYS.md); never write a key here. enabled_providers is a global allowlist (it cannot be set per agent): Groq returned 403 for the owner so it is excluded. The `free` agent is kept off customer data by its read-only tools plus its :free model id, not by this list. No model ids are added here; sambanova has an empty model list until config/models.yaml gains SambaNova ids.",
  "enabled_providers": ["openrouter", "mistral", "sambanova", "omniroute"],
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    },
    "mistral": {
      "options": {
        "apiKey": "{env:MISTRAL_API_KEY}"
      }
    },
    "sambanova": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SambaNova",
      "options": {
        "baseURL": "https://api.sambanova.ai/v1",
        "apiKey": "{env:SAMBANOVA_API_KEY}"
      },
      "models": {}
    },
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute (local gateway)",
      "options": {
        "baseURL": "{env:OMNIROUTE_BASE_URL}",
        "apiKey": "{env:OMNIROUTE_API_KEY}"
      },
      "models": {}
    }
  },
  "agent": {
    "plan": {
      "description": "Read-only: explore the repo and produce a plan. Never edits, never runs shell commands.",
      "model": "openrouter/deepseek/deepseek-v4.1-flash",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "patch": false
      },
      "permission": {
        "read": {
          "*": "allow",
          ".env*": "deny",
          "**/.env*": "deny",
          "*.pem": "deny",
          "**/*.pem": "deny",
          "*.key": "deny",
          "**/*.key": "deny",
          "database_snapshots/**": "deny",
          "*.sql": "deny",
          "**/*.sql": "deny",
          "*.tar.gz": "deny",
          "**/*.tar.gz": "deny",
          "repomix-output.xml": "deny",
          "**/repomix-output.xml": "deny"
        }
      }
    },
    "free": {
      "description": "Mechanical/non-sensitive chores only (formatting checks, doc typo scans, renaming). Read-only, same as `plan`. Must NEVER receive customer or case data: this model is config/models.yaml's `free` role, a non_sensitive_only, logs-or-trains-on-prompts provider (docs/STRATEGY.md §3b).",
      "model": "openrouter/qwen/qwen3.8-27b:free",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "patch": false
      },
      "permission": {
        "read": {
          "*": "allow",
          ".env*": "deny",
          "**/.env*": "deny",
          "*.pem": "deny",
          "**/*.pem": "deny",
          "*.key": "deny",
          "**/*.key": "deny",
          "database_snapshots/**": "deny",
          "*.sql": "deny",
          "**/*.sql": "deny",
          "*.tar.gz": "deny",
          "**/*.tar.gz": "deny",
          "repomix-output.xml": "deny",
          "**/repomix-output.xml": "deny"
        }
      }
    },
    "critical-reviewer": {
      "description": "Read-only critical reviewer for diffs touching auth, tenancy (ownership/tenant checks in the repository layer), payments (Zibal) and SSRF (outbound URL fetches). Reports pass/fail per area; never modifies anything. No `model` key on purpose: the id comes from config/models.yaml's `reviewer` role (via model_registry.py) and is passed with `--model`, the same mechanism as the executor id.",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "patch": false
      },
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "read": {
          "*": "allow",
          ".env*": "deny",
          "**/.env*": "deny",
          "*.pem": "deny",
          "**/*.pem": "deny",
          "*.key": "deny",
          "**/*.key": "deny",
          "database_snapshots/**": "deny",
          "*.sql": "deny",
          "**/*.sql": "deny",
          "*.tar.gz": "deny",
          "**/*.tar.gz": "deny",
          "repomix-output.xml": "deny",
          "**/repomix-output.xml": "deny"
        }
      }
    },
    "build": {
      "description": "Implements one GitHub-issue-labelled task in a worktree/branch (W10 phase 2, agent-task.yml). Runs non-interactively in CI: no `ask` permissions anywhere. Never pushes to main, never force-deletes, never touches secrets or the network directly.",
      "model": "openrouter/deepseek/deepseek-v4.1-flash",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "patch": true
      },
      "permission": {
        "read": {
          "*": "allow",
          ".env*": "deny",
          "**/.env*": "deny",
          "*.pem": "deny",
          "**/*.pem": "deny",
          "*.key": "deny",
          "**/*.key": "deny",
          "database_snapshots/**": "deny",
          "*.sql": "deny",
          "**/*.sql": "deny",
          "*.tar.gz": "deny",
          "**/*.tar.gz": "deny",
          "repomix-output.xml": "deny",
          "**/repomix-output.xml": "deny"
        },
        "edit": "allow",
        "write": "allow",
        "webfetch": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git add*": "allow",
          "git commit*": "allow",
          "git checkout -b*": "allow",
          "git switch -c*": "allow",
          "ls*": "allow",
          "cat *": "allow",
          "grep*": "allow",
          "find*": "allow",
          "python3 -m py_compile*": "allow",
          "ruff check*": "allow",
          "ruff format --check*": "allow",
          "pytest -m \"not integration\"*": "allow",
          "npm run lint*": "allow",
          "npm run build*": "allow",
          "npm test*": "allow",
          "cat *.env*": "deny",
          "cat */.env*": "deny",
          "cat .env*": "deny",
          "curl*": "deny",
          "wget*": "deny",
          "rm -rf*": "deny",
          "sudo*": "deny",
          "git push*": "deny",
          "git reset --hard*": "deny",
          "git clean -f*": "deny",
          "git push --force*": "deny",
          "ssh*": "deny",
          "scp*": "deny",
          "*5.75.200.67*": "deny",
          "*DROP *": "deny",
          "*drop *": "deny",
          "*DELETE FROM*": "deny",
          "*delete from*": "deny"
        }
      }
    }
  }
}
