# Environment & Secrets
.env
*.env
# Stray env backups (for example .env.bak-STAMP) must never make the tree dirty
.env.bak*
.env.*.bak*
*.pem
*.key
*.cert

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Databases & Vector Storages (Local Volumes)
data/qdrant_storage/
data/postgres_data/
*.sqlite3
*.db

# Temporary Uploads & User Media
temp_audio/
uploads/
*.wav
*.mp3
*.webm
*.ogg

# Tech Radar append-only research history (root report is tracked)
data/tech_radar/

# Tech Radar runtime output (issue #78): the scheduled sentinel writes here, not
# into the checkout. The committed TECH_RADAR_PROPOSALS.md and
# frontend/public/tech_radar_report.json are static placeholders only.
var/tech_radar/

# W6: raw HF dataset snapshots downloaded by scripts/w6_ingest_dotic.py --build
# (rebuild with the command documented in docs/W6_legal_corpus_diagnosis.md;
# the built JSONL under data/legal/ is tracked, this raw source is not)
data/raw/

# Factory isolated worktrees (never interfere with active server source)
.factory_worktrees/

# System & Logs
*.log
.DS_Store
.idea/
.vscode/
node_modules/
dist/
.aider*
twenty_data/

# Claude Code: personal permissions and agent worktrees (never commit)
.claude/settings.local.json
.claude/worktrees/

# Python virtualenv (server uses its own /opt/roxira_platform/venv, never the repo copy)
venv/
.venv/

# DB dumps, vector-store snapshots and repomix bundles (never commit; see docs/HISTORY_REWRITE.md)
*.sql
*.sql.gz
database_snapshots/
*.tar.gz
*.snapshot
repomix-output.xml

# generated on the server by scripts/ops/nginx (never commit)
nginx/generated/*
!nginx/generated/.keep.conf
nginx/ssl-default/
.venv-crawl/

# nginx vhosts generated on the server (sandbox runner, scripts/infra/vpn/add_paths.sh); never tracked
nginx/sandboxes/
