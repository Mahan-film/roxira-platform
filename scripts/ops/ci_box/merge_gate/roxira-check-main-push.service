[Unit]
Description=Roxira alert on direct pushes to main (one check)

[Service]
Type=oneshot
# Telegram: NOTIFY_BOT_TOKEN / NOTIFY_CHAT_ID from this file (mode 600, never in the repo); optional.
EnvironmentFile=-%h/.config/roxira-merge-gate/notify.env
ExecStart=/usr/bin/python3 %h/roxira-merge-gate/check_main_push.py --config %h/.config/roxira-merge-gate/merge_gate.toml
TimeoutStartSec=120
Nice=10
