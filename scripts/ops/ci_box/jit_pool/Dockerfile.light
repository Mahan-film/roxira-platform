# Light-slot image for JIT runners (R20-8, #1024): lint, unit tests and scanners, no Docker inside.
# Built by runner_setup.sh as user `runner` with rootless Docker; the build context is the runner
# template (a pristine actions/runner release, SHA-256 checked), never the old runner's directory.
# Base from public.ecr.aws: Docker Hub is blocked from this network.
# Pinned by sha256 digest (multi-arch index digest of ubuntu:24.04, read from the registry 2026-11-23),
# so a moved or poisoned tag cannot change the CI image. The tag stays for humans; Docker uses the
# digest. To bump: read the new index digest (docker buildx imagetools inspect <image>:24.04), replace
# it here; src/ops/test_jit_watchdog.py checks the pin format.
FROM public.ecr.aws/docker/library/ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289

ARG DEBIAN_FRONTEND=noninteractive
# Runner (.NET) needs libicu/libssl/krb5/lttng; jobs need git, curl, jq, unzip, xz, zstd, python3.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl git git-lfs gnupg jq unzip xz-utils zstd tar gzip bzip2 \
      python3 python3-venv python3-pip build-essential openssl \
      libicu74 libssl3t64 libkrb5-3 zlib1g liblttng-ust1t64 \
 && rm -rf /var/lib/apt/lists/*
# ubuntu:24.04 ships user "ubuntu" with uid 1000; the runner takes that uid instead.
RUN if id ubuntu >/dev/null 2>&1; then userdel -r ubuntu; fi \
 && useradd -m -u 1000 -s /bin/bash runner \
 && mkdir -p /opt/hostedtoolcache \
 && chown runner:runner /opt/hostedtoolcache \
 && printf '%s\n' \
      '# Isolate per-job pip installs into $RUNNER_TEMP/venv when /opt/hostedtoolcache is read-only.' \
      'if [ -n "${RUNNER_TEMP:-}" ] && [ -d "$RUNNER_TEMP" ]; then' \
      '  _rx_venv="$RUNNER_TEMP/venv"' \
      '  _rx_py="$(command -v python3 2>/dev/null || true)"' \
      '  if [ -n "$_rx_py" ] && [ "$_rx_py" != "$_rx_venv/bin/python3" ]; then' \
      '    _rx_prev="$(cat "$_rx_venv/.py_base" 2>/dev/null || true)"' \
      '    if [ ! -x "$_rx_venv/bin/python3" ] || [ "$_rx_prev" != "$_rx_py" ]; then' \
      '      rm -rf "$_rx_venv" && "$_rx_py" -m venv --system-site-packages "$_rx_venv" >/dev/null 2>&1 && printf "%s\n" "$_rx_py" > "$_rx_venv/.py_base" || true' \
      '    fi' \
      '  fi' \
      '  if [ -x "$_rx_venv/bin/python3" ]; then' \
      '    export VIRTUAL_ENV="$_rx_venv"' \
      '    case ":$PATH:" in *":$_rx_venv/bin:"*) ;; *) export PATH="$_rx_venv/bin:$PATH" ;; esac' \
      '  fi' \
      '  unset _rx_venv _rx_py _rx_prev' \
      'fi' > /usr/local/share/roxira-pip-venv.sh \
 && chmod 0644 /usr/local/share/roxira-pip-venv.sh

COPY --chown=runner:runner . /home/runner/actions-runner
USER runner
WORKDIR /home/runner/actions-runner
ENV RUNNER_TOOL_CACHE=/opt/hostedtoolcache \
    AGENT_TOOLSDIRECTORY=/opt/hostedtoolcache \
    ImageOS=ubuntu24 \
    LANG=C.UTF-8
# The JIT config arrives as ACTIONS_RUNNER_INPUT_JITCONFIG (env file); one job, then exit.
CMD ["/home/runner/actions-runner/run.sh"]
