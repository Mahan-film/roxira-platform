# Local proxy only; never edit this to bypass it. Iranian hosts are routed direct by the proxy's own rules.
HTTPS_PROXY=http://127.0.0.1:10809
HTTP_PROXY=http://127.0.0.1:10809
NO_PROXY=localhost,127.0.0.1
# Owner decision 2026-11-23: collect everything public, filter later. Empty = dry-run/report mode (nothing is written except the report). Set to --commit to update state and
# write staged JSONL under ~/.local/state/roxira-source-watcher/staged/.
SOURCE_WATCHER_ARGS=--commit --details 6
