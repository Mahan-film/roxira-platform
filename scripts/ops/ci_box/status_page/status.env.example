# Optional settings for the box status page (no secrets here). Copy to ~/.config/roxira-status/status.env.
# STATUS_BIND=127.0.0.1      # LAN address of the box to reach the page from another computer; never a public address
# STATUS_PORT=8088
# STATUS_REPO=<owner>/<repo> # default: taken from `gh repo view`
# STATUS_DAILY_CAP_USD=1.0   # gateway key cap per day (alerts at 80 percent)
# STATUS_DATA_DISK=/srv/data
