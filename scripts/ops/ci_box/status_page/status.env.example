# Optional settings for the box status page (no secrets here). Copy to ~/.config/roxira-status/status.env.
# STATUS_BIND=127.0.0.1      # LAN address of the box to reach the page from another computer; never a public address
# STATUS_PORT=8088
# STATUS_REPO=<owner>/<repo> # default: taken from `gh repo view`
# STATUS_DAILY_CAP_USD=1.0   # gateway key cap per day (alerts at 80 percent)
# STATUS_DATA_DISK=/srv/data
# --- phone line probes (work package G); all optional, defaults are fine ---
# PHONE_SIP_PORTS=5060,5062          # destination ports whose firewall drops from outside the LAN raise an alert
# PHONE_CARRIER_CIDRS=               # comma list; when set only drops from these networks count (keep it out of git)
# PHONE_LOG_MB_DAY=100               # alert when one phone container logs more than this per day (no log rotation is set)
# PHONE_CALL_STALE_H=0               # alert when no inbound call for this many hours (0 = display only)
# PHONE_FIRST_AUDIO_TARGET_MS=1500   # nightly voice test first-audio p50 target (only used once that report exists)
# PHONE_SIGNALS_FILE=/var/lib/roxira-phone/phone-signals.json
# PHONE_VOICE_REPORT=/srv/data/phone/voice-test/latest.json
