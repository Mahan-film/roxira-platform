# ~/.config/roxira-lane/gateway.env  (mode 600, NEVER in git). Created empty by install_user.sh; the owner fills it
# through the relay in docs/ops/BOX_LANE_RUNNER.md (step 5). The name is KEYPOOL_MASTER_KEY because run_task.sh expects
# it, but the value is this machine's restricted VIRTUAL key, not the gateway master key.
KEYPOOL_MASTER_KEY=
