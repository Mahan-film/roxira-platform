# Copy to ~/.config/roxira-bridge/env (chmod 600). Put the real local proxy port in on the box only.
HTTPS_PROXY=http://127.0.0.1:<port>
HTTP_PROXY=http://127.0.0.1:<port>
NO_PROXY=127.0.0.1,localhost
# Optional API-key mode (only used when auth_mode = "api_key" in bridge.toml; off by default):
# ANTHROPIC_API_KEY=
