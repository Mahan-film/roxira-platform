# Polls TronGrid for USDT-TRC20 payments (no-op unless CRYPTO_PAY_ENABLED=1). See docs/ops/CRYPTO_PAYMENTS.md.
[Unit]
Description=Roxira USDT TRC20 payment poller
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/roxira_platform
# Runs inside the app container: it has psycopg, the billing code under /app and the CRYPTO_*/DB env
# (from /opt/roxira_platform/.env via compose). The host python has no psycopg.
StandardInput=file:/opt/roxira_platform/scripts/ops/crypto/poll_usdt.py
ExecStart=/usr/bin/docker exec -i -w /app -e PYTHONPATH=/app roxira_app_prod python3 -
TimeoutStartSec=60
Nice=10
