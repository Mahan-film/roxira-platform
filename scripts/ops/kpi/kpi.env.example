# Copy to /etc/roxira/kpi.env (chmod 600) on the server. Names only: put real values there, never here.
# Umami API token: created in the Umami UI (API keys). Website ids: the Umami website for each host.
UMAMI_API_URL=http://127.0.0.1:3005/umami
UMAMI_API_TOKEN=
UMAMI_WEBSITE_ROXIRA=
UMAMI_WEBSITE_GHAZI=
# Optional overrides (defaults: see weekly_report.py --help):
# KEYPOOL_COST_LOG=/var/log/roxira-keypool/requests.jsonl
# TASKQ_DB=/var/lib/roxira-agents/taskq.db
# AUTODEPLOY_STATE_DIR=/root/deploy-state
