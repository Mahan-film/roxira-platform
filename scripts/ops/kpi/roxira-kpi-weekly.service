# Weekly KPI report to the owner bot (factory milestone F7). Installed by scripts/ops/kpi/install.sh.
# Read-only: it reads the Umami API, requests.jsonl, taskq.db (mode=ro) and the deploy state, then
# hands one message to notify.py. See docs/ops/OBSERVABILITY.md.
[Unit]
Description=Roxira weekly KPI report (owner bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/roxira_platform
# Optional: UMAMI_API_TOKEN and UMAMI_WEBSITE_* live here (mode 600), not in the repo.
EnvironmentFile=-/opt/roxira_platform/.env
EnvironmentFile=-/etc/roxira/kpi.env
ExecStart=/usr/bin/python3 /opt/roxira_platform/scripts/ops/kpi/weekly_report.py
TimeoutStartSec=300
Nice=10
